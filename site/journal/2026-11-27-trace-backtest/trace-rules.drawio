<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net">
  <diagram id="evidence" name="공급계약과 원문 근거">
    <mxGraphModel grid="1" page="1" pageWidth="1000" pageHeight="530">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" value="두 공급계약에서 확인한 기업 역할" vertex="1" style="text;align=left;verticalAlign=middle;fontSize=26;fontStyle=1;">
          <mxGeometry as="geometry" x="25" y="20" width="945" height="52" />
        </mxCell>
        <mxCell id="note" parent="1" value="실제 계약별 원문 근거입니다. 두 계약 간 물량·대금의 직접 연결은 확인하지 않았습니다." vertex="1" style="text;align=left;verticalAlign=middle;fontSize=15;fontColor=#495a72;">
          <mxGeometry as="geometry" x="25" y="477" width="945" height="38" />
        </mxCell>
        <mxCell id="supplier" parent="1" value="&lt;b&gt;동성화인텍&lt;/b&gt;&lt;br&gt;Company" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aafd6;fontSize=15;">
          <mxGeometry as="geometry" x="28" y="128" width="146" height="58" />
        </mxCell>
        <mxCell id="contract1" parent="1" value="&lt;b&gt;보냉자재 공급계약&lt;/b&gt;&lt;br&gt;TraceSupplyContract" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aafd6;fontSize=15;">
          <mxGeometry as="geometry" x="211" y="128" width="174" height="58" />
        </mxCell>
        <mxCell id="middle" parent="1" value="&lt;b&gt;HD현대중공업&lt;/b&gt;&lt;br&gt;Company" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aafd6;fontSize=15;">
          <mxGeometry as="geometry" x="420" y="128" width="160" height="58" />
        </mxCell>
        <mxCell id="contract2" parent="1" value="&lt;b&gt;컨테이너선 계약&lt;/b&gt;&lt;br&gt;TraceSupplyContract" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aafd6;fontSize=15;">
          <mxGeometry as="geometry" x="614" y="128" width="174" height="58" />
        </mxCell>
        <mxCell id="buyer" parent="1" value="&lt;b&gt;HMM&lt;/b&gt;&lt;br&gt;Company" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aafd6;fontSize=15;">
          <mxGeometry as="geometry" x="824" y="128" width="146" height="58" />
        </mxCell>
        <mxCell id="proof1" parent="1" value="&lt;b&gt;20261105900115&lt;/b&gt;&lt;br&gt;원문 XML 117행" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aafd6;fontSize=15;">
          <mxGeometry as="geometry" x="211" y="236" width="174" height="67" />
        </mxCell>
        <mxCell id="proof2" parent="1" value="&lt;b&gt;20261020800221&lt;/b&gt;&lt;br&gt;원문 XML 109행" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aafd6;fontSize=15;">
          <mxGeometry as="geometry" x="614" y="236" width="174" height="67" />
        </mxCell>
        <mxCell id="edge0" value="공급" parent="1" edge="1" source="supplier" target="contract1" style="endArrow=block;endFill=1;strokeColor=#244acb;strokeWidth=2;labelBackgroundColor=#f2f6ff;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="edge1" value="구매" parent="1" edge="1" source="middle" target="contract1" style="endArrow=block;endFill=1;strokeColor=#244acb;strokeWidth=2;labelBackgroundColor=#f2f6ff;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="edge2" value="공급" parent="1" edge="1" source="middle" target="contract2" style="endArrow=block;endFill=1;strokeColor=#244acb;strokeWidth=2;labelBackgroundColor=#f2f6ff;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="edge3" value="구매" parent="1" edge="1" source="buyer" target="contract2" style="endArrow=block;endFill=1;strokeColor=#244acb;strokeWidth=2;labelBackgroundColor=#f2f6ff;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="edge4" value="원문 근거" parent="1" edge="1" source="contract1" target="proof1" style="endArrow=block;endFill=1;strokeColor=#244acb;strokeWidth=2;labelBackgroundColor=#f2f6ff;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="edge5" value="원문 근거" parent="1" edge="1" source="contract2" target="proof2" style="endArrow=block;endFill=1;strokeColor=#244acb;strokeWidth=2;labelBackgroundColor=#f2f6ff;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="rules" name="실험에 사용한 관계 패턴">
    <mxGraphModel grid="1" page="1" pageWidth="1000" pageHeight="530">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" value="관계 패턴을 다음 거래일 예측 변수로 변환" vertex="1" style="text;align=left;verticalAlign=middle;fontSize=26;fontStyle=1;">
          <mxGeometry as="geometry" x="25" y="20" width="945" height="52" />
        </mxCell>
        <mxCell id="note" parent="1" value="모든 변수는 체결일 전에 생성합니다. 경로 발굴은 별도의 후속 실험입니다." vertex="1" style="text;align=left;verticalAlign=middle;fontSize=15;fontColor=#495a72;">
          <mxGeometry as="geometry" x="25" y="477" width="945" height="38" />
        </mxCell>
        <mxCell id="cutoff" parent="1" value="&lt;b&gt;접수일 기준&lt;/b&gt;&lt;br&gt;공시와 구매자 식별 근거 확인" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aafd6;fontSize=15;">
          <mxGeometry as="geometry" x="28" y="383" width="196" height="76" />
        </mxCell>
        <mxCell id="role" parent="1" value="&lt;b&gt;관계 패턴&lt;/b&gt;&lt;br&gt;기업 → 계약 ← 상대 기업" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aafd6;fontSize=15;">
          <mxGeometry as="geometry" x="274" y="383" width="196" height="76" />
        </mxCell>
        <mxCell id="features" parent="1" value="&lt;b&gt;관계 변수&lt;/b&gt;&lt;br&gt;역할·상대 모멘텀·이전 계약 수" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aafd6;fontSize=15;">
          <mxGeometry as="geometry" x="520" y="383" width="196" height="76" />
        </mxCell>
        <mxCell id="model" parent="1" value="&lt;b&gt;예측·평가&lt;/b&gt;&lt;br&gt;다음 거래일 시가→종가" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aafd6;fontSize=15;">
          <mxGeometry as="geometry" x="766" y="383" width="204" height="76" />
        </mxCell>
        <mxCell id="edge0" value="" parent="1" edge="1" source="cutoff" target="role" style="endArrow=block;endFill=1;strokeColor=#244acb;strokeWidth=2;labelBackgroundColor=#f2f6ff;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="edge1" value="" parent="1" edge="1" source="role" target="features" style="endArrow=block;endFill=1;strokeColor=#244acb;strokeWidth=2;labelBackgroundColor=#f2f6ff;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="edge2" value="" parent="1" edge="1" source="features" target="model" style="endArrow=block;endFill=1;strokeColor=#244acb;strokeWidth=2;labelBackgroundColor=#f2f6ff;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
